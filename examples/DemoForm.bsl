&НаКлиенте
Процедура Проверить(Команда)
    ПроверитьНаСервере();
    Сообщить("Проверки пройдены: остатки, нулевой остаток и блокировка перерасхода.");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьНаСервере()
    Журнал = СкладскойКонтроль.НовыйЖурналДвижений();
    ДобавитьДвижение(Журнал, "Основной", "КБ-01", "Приход", 10);
    ДобавитьДвижение(Журнал, "Основной", "КБ-01", "Расход", 4);
    ДобавитьДвижение(Журнал, "Резервный", "КБ-01", "Приход", 2);
    ДобавитьДвижение(Журнал, "Резервный", "КБ-01", "Расход", 2);

    Остатки = СкладскойКонтроль.РассчитатьОстатки(Журнал);
    Если Остатки.Количество() <> 2 Тогда
        ВызватьИсключение "Ожидались две строки остатков.";
    КонецЕсли;
    Если Остатки[0].Склад <> "Основной" Или Остатки[0].Остаток <> 6
        Или Остатки[1].Склад <> "Резервный" Или Остатки[1].Остаток <> 0 Тогда
        ВызватьИсключение "Остатки по складам не совпали с ожидаемыми.";
    КонецЕсли;

    ДобавитьДвижение(Журнал, "Основной", "КБ-01", "Расход", 7);
    Попытка
        СкладскойКонтроль.РассчитатьОстатки(Журнал);
    Исключение
        Если СтрНайти(ОписаниеОшибки(), "Строка 5: недостаточно товара") > 0 Тогда
            Возврат;
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    ВызватьИсключение "Ожидалась ошибка при перерасходе.";
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьДвижение(Журнал, Склад, Артикул, Вид, Количество)
    СтрокаЖурнала = Журнал.Добавить();
    СтрокаЖурнала.Склад = Склад;
    СтрокаЖурнала.Артикул = Артикул;
    СтрокаЖурнала.Вид = Вид;
    СтрокаЖурнала.Количество = Количество;
КонецПроцедуры
