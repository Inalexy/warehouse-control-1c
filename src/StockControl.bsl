// Неглобальный общий модуль СкладскойКонтроль. Свойство: Сервер.

Функция НовыйЖурналДвижений() Экспорт
    Журнал = Новый ТаблицаЗначений;
    Журнал.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка"));
    Журнал.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
    Журнал.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
    Журнал.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Возврат Журнал;
КонецФункции

Функция РассчитатьОстатки(Журнал) Экспорт
    Остатки = Новый ТаблицаЗначений;
    Остатки.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка"));
    Остатки.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
    Остатки.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
    Остатки.Индексы.Добавить("Склад, Артикул");

    НомерСтроки = 0;
    Для Каждого Движение Из Журнал Цикл
        НомерСтроки = НомерСтроки + 1;
        Склад = СокрЛП(Движение.Склад);
        Артикул = СокрЛП(Движение.Артикул);
        Если ПустаяСтрока(Склад) Или ПустаяСтрока(Артикул)
            Или Движение.Количество <= 0 Тогда
            ВызватьИсключение СтрШаблон("Строка %1: укажите склад, артикул и положительное количество.", НомерСтроки);
        КонецЕсли;

        Если Движение.Вид = "Приход" Тогда
            Изменение = Движение.Количество;
        ИначеЕсли Движение.Вид = "Расход" Тогда
            Изменение = -Движение.Количество;
        Иначе
            ВызватьИсключение СтрШаблон("Строка %1: неизвестный вид движения.", НомерСтроки);
        КонецЕсли;

        Отбор = Новый Структура("Склад, Артикул", Склад, Артикул);
        Найденные = Остатки.НайтиСтроки(Отбор);
        Если Найденные.Количество() = 0 Тогда
            СтрокаОстатка = Остатки.Добавить();
            СтрокаОстатка.Склад = Склад;
            СтрокаОстатка.Артикул = Артикул;
        Иначе
            СтрокаОстатка = Найденные[0];
        КонецЕсли;

        СтрокаОстатка.Остаток = СтрокаОстатка.Остаток + Изменение;
        Если СтрокаОстатка.Остаток < 0 Тогда
            ВызватьИсключение СтрШаблон(
                "Строка %1: недостаточно товара %2 на складе %3.", НомерСтроки, Артикул, Склад);
        КонецЕсли;
    КонецЦикла;

    Остатки.Сортировать("Склад, Артикул");
    Возврат Остатки;
КонецФункции
